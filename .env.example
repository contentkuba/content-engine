# Copy to .env and fill in. Never commit .env.

# DataForSEO (same creds the dfs-mcp server uses)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google service account key file (share each client sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# Per-client CMS secrets. Name them <CLIENT>_..., referenced from clients/<client>.yaml
# WordPress example (Application Password)
ACME_WP_USER=
ACME_WP_APP_PASSWORD=

# neverupgrade.com (test site)
NEVERUPGRADE_WP_USER=
NEVERUPGRADE_WP_APP_PASSWORD=

# Wix example (API key + site id)
BLOOM_WIX_API_KEY=
BLOOM_WIX_SITE_ID=
